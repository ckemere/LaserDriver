**/Debug/**

**/.DS_Store
.venv/*

# Python bytecode / test cache
**/__pycache__/
*.pyc
.pytest_cache/

# KiCad per-user state and caches
**/*.kicad_prl
**/fp-info-cache
**/*-backups/

# simulation output (regenerated by the sim scripts)
**/sim/results/

# unzipped Gerbers (the zip next to them is the deliverable)
hardware/fab/*/gerbers/

# KiCad lock and autosave files
**/~*.lck
**/_autosave-*
**/#auto_saved_files#

# simple battery pack autorouter intermediates and board snapshots
hardware/SimpleBatteryPack/route/

# Fabrication Toolkit's automatic backups of earlier outputs
hardware/**/production/backups/
