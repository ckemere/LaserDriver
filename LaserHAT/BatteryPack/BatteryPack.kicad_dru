(version 1)
(rule power_tracks
  (comment "0.3 mm between different Power-class nets wherever a track or via is involved (pad rows inside one footprint keep the board minimum)")
  (condition "A.NetClass == 'Power' && B.NetClass == 'Power' && A.NetName != B.NetName && (A.Type == 'Track' || A.Type == 'Via' || B.Type == 'Track' || B.Type == 'Via')")
  (constraint clearance (min 0.3mm)))
(rule hv34
  (comment "33.6 V between the +V rail nets and GND / -V / CGND: 0.5 mm (margin; IPC-2221 B4 asks 0.13 mm)")
  (condition "(A.Type == 'Track' || A.Type == 'Via' || B.Type == 'Track' || B.Type == 'Via') && ((A.NetName == '+BATB' && B.NetName == 'GND') || (A.NetName == 'GND' && B.NetName == '+BATB') || (A.NetName == '+BATB' && B.NetName == 'CGND') || (A.NetName == 'CGND' && B.NetName == '+BATB') || (A.NetName == '+BATB' && B.NetName == '/CGND_K') || (A.NetName == '/CGND_K' && B.NetName == '+BATB') || (A.NetName == '+BATB' && B.NetName == '/-V') || (A.NetName == '/-V' && B.NetName == '+BATB') || (A.NetName == '+BATB' && B.NetName == '/GNDF') || (A.NetName == '/GNDF' && B.NetName == '+BATB') || (A.NetName == '+OUT' && B.NetName == 'GND') || (A.NetName == 'GND' && B.NetName == '+OUT') || (A.NetName == '+OUT' && B.NetName == 'CGND') || (A.NetName == 'CGND' && B.NetName == '+OUT') || (A.NetName == '+OUT' && B.NetName == '/CGND_K') || (A.NetName == '/CGND_K' && B.NetName == '+OUT') || (A.NetName == '+OUT' && B.NetName == '/-V') || (A.NetName == '/-V' && B.NetName == '+OUT') || (A.NetName == '+OUT' && B.NetName == '/GNDF') || (A.NetName == '/GNDF' && B.NetName == '+OUT') || (A.NetName == '+SW' && B.NetName == 'GND') || (A.NetName == 'GND' && B.NetName == '+SW') || (A.NetName == '+SW' && B.NetName == 'CGND') || (A.NetName == 'CGND' && B.NetName == '+SW') || (A.NetName == '+SW' && B.NetName == '/CGND_K') || (A.NetName == '/CGND_K' && B.NetName == '+SW') || (A.NetName == '+SW' && B.NetName == '/-V') || (A.NetName == '/-V' && B.NetName == '+SW') || (A.NetName == '+SW' && B.NetName == '/GNDF') || (A.NetName == '/GNDF' && B.NetName == '+SW'))")
  (constraint clearance (min 0.5mm)))
