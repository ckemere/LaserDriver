  (symbol (lib_id "battpack:CGND") (at 586.74 203.2 0) (unit 1) (exclude_from_sim no) (in_bom no) (on_board no) (dnp no)
    (uuid "074cdbde-735d-5cdd-accc-ecb6cc29ed83")
