  (text "Two identical boards stacked on 25 mm M3 standoffs; lower J3 -> upper J4 with a straight 4-wire JST-PH cable: lower +OUT -> upper GND" (exclude_from_sim no) (at 210.82 353.06 0) (effects (font (size 1.27 1.27)) (justify left bottom)) (uuid "8106794d-756e-522a-be92-311d6b86bcd2"))
  (text "(= 0 V), lower OUT_GND -> LINK_N -> upper J3.3 (= -V), upper +RUN -> lower STACK_IN (slave enable).  Upper J3 = +V / 0 V / -V / (+RUN) to the" (exclude_from_sim no) (at 210.82 358.14 0) (effects (font (size 1.27 1.27)) (justify left bottom)) (uuid "665d7e0e-47d1-5cd4-8f95-8142cb552247"))
  (text "e-stim module.  Lower toggle: OFF normally (its output follows the upper toggle), CHARGE to charge; RUN only for a board on its own." (exclude_from_sim no) (at 210.82 363.22 0) (effects (font (size 1.27 1.27)) (justify left bottom)) (uuid "cf118cf5-f0d0-5bcc-98df-7cd2c83959ef"))
  (text "Charging: either or both toggles in CHARGE, plug USB-C PD bricks in; a charging board has both output lines open, so grounds never loop." (exclude_from_sim no) (at 210.82 368.3 0) (effects (font (size 1.27 1.27)) (justify left bottom)) (uuid "b8462939-5116-5c7b-9e9f-1072c95b30b9"))
  (rectangle (start 350.52 20.32) (end 497.84 279.4) (stroke (width 0.2) (type dash)) (fill (type none)) (uuid "43f93cd1-c8d2-5712-a8e5-1b3360cb20f4"))
