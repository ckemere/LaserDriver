  (label "VS" (at 193.04 231.14 180) (fields_autoplaced yes) (effects (font (size 1.27 1.27)) (justify right bottom)) (uuid "939c2443-d71b-57b1-ae41-390202f8b5e7"))
  (label "THCUT" (at 193.04 236.22 180) (fields_autoplaced yes) (effects (font (size 1.27 1.27)) (justify right bottom)) (uuid "eabe5122-179d-597c-a538-b54b23b88c8f"))
  (label "Q11_G" (at 213.36 233.68 0) (fields_autoplaced yes) (effects (font (size 1.27 1.27)) (justify left bottom)) (uuid "d3fd6994-3368-5ca6-8cd7-c5a87738985b"))
  (text "SW1 pole 1 (common 0V = pack B negative): RUN -> +BAT (packs in series, 0V = output 0 V); CHARGE -> GND (negatives joined).  Pole 2 (common +BATB):" (exclude_from_sim no) (at 17.78 256.54 0) (effects (font (size 1.27 1.27)) (justify left bottom)) (uuid "4de0d983-bcef-5549-b26e-62b935ca7587"))
  (text "RUN -> +RUN -> F1 -> +SW -> Q1 -> +OUT (+V); CHARGE -> +CHGB -> F3 (1.1 A PTC) -> +BAT (positives joined: both packs on the one charger).  OFF opens both," (exclude_from_sim no) (at 17.78 261.62 0) (effects (font (size 1.27 1.27)) (justify left bottom)) (uuid "c451c4d7-29a6-51c9-a532-1f7732209428"))
  (text "R30 holds 0V at GND.  Q1: U15B pulls the gate low (R1/R2) while VSB > THCUTB.  Q11 (N, on pack A's negative): R39 from 0V and R40 give Vgs = +BAT/2 in RUN;" (exclude_from_sim no) (at 17.78 266.7 0) (effects (font (size 1.27 1.27)) (justify left bottom)) (uuid "6a14552c-c121-5793-94dd-ae83e9efc70d"))
  (text "U2B pulls the gate low below 12.0 V (R11 470k from the gate: back on at 12.9 V); in OFF and CHARGE 0V is at GND, so Q11 is off and -V floats.  Gauge rails:" (exclude_from_sim no) (at 17.78 271.78 0) (effects (font (size 1.27 1.27)) (justify left bottom)) (uuid "6f2826e2-8e8c-51d8-a7ce-b6d5ce18daee"))
  (text "+GB = +SW or +CHGB (D5/D6), +G = 0V or +CHGB (D15/D16): both gauges run in RUN and CHARGE and are dead in OFF." (exclude_from_sim no) (at 17.78 276.86 0) (effects (font (size 1.27 1.27)) (justify left bottom)) (uuid "be686484-8014-5fdb-9d62-fc00f091ddd2"))
  (rectangle (start 259.08 127) (end 396.24 233.68) (stroke (width 0.2) (type dash)) (fill (type none)) (uuid "aa12ec0c-4748-5987-b222-897c0aa5ea8a"))
  (text "3A. PACK A: 2.495 V REFERENCE, LADDER, SAMPLE (on +G)" (exclude_from_sim no) (at 260.35 130.81 0) (effects (font (size 2.0 2.0) (bold yes)) (justify left bottom)) (uuid "02b2b620-7f6c-5196-bdfc-1542585a2ef9"))
