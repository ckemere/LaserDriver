  (label "Q4_GD" (at 193.04 168.91 270) (fields_autoplaced yes) (effects (font (size 1.27 1.27)) (justify right bottom)) (uuid "cc831bd7-e1bd-5d4b-803a-5ea1fbcc5196"))
  (text "SW1 pole 1 (common +BAT): RUN -> +RUN -> F1 (100 mA hold, 300 mA trip) -> +SW -> Q1 -> +OUT; CHARGE -> +CHG.  Pole 2 (common GND): RUN -> OUT_GND (J3.2);" (exclude_from_sim no) (at 17.78 251.46 0) (effects (font (size 1.27 1.27)) (justify left bottom)) (uuid "0a693e75-c349-50a7-903c-6c3137cb1cf4"))
  (text "CHARGE -> CGND (USB-C ground, charger return).  OFF opens both.  Gauge rail +G = +SW or +CHG through D5 / D6.  U2B pulls Q1's gate low" (exclude_from_sim no) (at 17.78 256.54 0) (effects (font (size 1.27 1.27)) (justify left bottom)) (uuid "90f5f5fa-060b-558f-882e-47ed9b47ae19"))
  (text "(R1/R2: Vgs = -(+SW)/2) while VS > THCUT: +OUT off below 12.0 V, back on above 12.8 V (R11).  Slave: with the upper board in RUN its +RUN" (exclude_from_sim no) (at 17.78 261.62 0) (effects (font (size 1.27 1.27)) (justify left bottom)) (uuid "4b509625-15c3-54fd-ae07-ff55fa8b0a47"))
  (text "arrives on J3.4 (STACK_IN), Q2 (gate on +OUT = upper GND) sources into Q3's gate, Q3 pulls Q4's gate down, Q4 feeds +RUN.  Q5 blocks it in CHARGE." (exclude_from_sim no) (at 17.78 266.7 0) (effects (font (size 1.27 1.27)) (justify left bottom)) (uuid "b98c9648-0f35-5a41-a440-a1edf2bfdff4"))
  (rectangle (start 208.28 121.92) (end 345.44 228.6) (stroke (width 0.2) (type dash)) (fill (type none)) (uuid "065f3423-fedc-5a69-8ef7-23b2fb472b6b"))
  (text "3. 2.495 V REFERENCE, THRESHOLD LADDER, PACK SAMPLE (on +G)" (exclude_from_sim no) (at 209.55 125.73 0) (effects (font (size 2.0 2.0) (bold yes)) (justify left bottom)) (uuid "db436d45-5bc8-5e02-9b9a-0c7a8c33fe38"))
