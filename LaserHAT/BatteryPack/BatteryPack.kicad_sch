  (text "cell 4" (exclude_from_sim no) (at 482.6 66.04 0) (effects (font (size 1.27 1.27)) (justify left bottom)) (uuid "34f132c7-5491-5a21-9602-b4b6cd8e5199"))
  (text "Any 4S LiPo / Li-ion hobby pack with a JST-XH 2.5 mm 5-pin balance plug and an XT60 discharge plug.  Pack A's positive and pack B's negative are one node, 0V, the output reference: the" (exclude_from_sim no) (at 17.78 114.3 0) (effects (font (size 1.27 1.27)) (justify left bottom)) (uuid "43156ffc-cac7-5c36-bbe6-3eec3c6af0e2"))
  (text "packs are never reconfigured.  Balancer per cell: HY2213 OUT drives an AO3400A that bleeds the cell through 100 R (42 mA, 0.18 W) above 4.200 V, off at 4.19 V; 2.5 uA standing." (exclude_from_sim no) (at 17.78 119.38 0) (effects (font (size 1.27 1.27)) (justify left bottom)) (uuid "baacbd2a-c640-59b2-96ae-649ed69cc582"))
  (rectangle (start 15.24 127) (end 254 284.48) (stroke (width 0.2) (type dash)) (fill (type none)) (uuid "8bc6ee33-057c-5e50-985a-7584a239b78f"))
  (text "2. ON / OFF TOGGLE, OUTPUT CHAINS (+V: Q1, -V: Q11), PLUG INTERLOCK (Q22), CHARGING INTERLOCK (U17)" (exclude_from_sim no) (at 16.51 130.81 0) (effects (font (size 2.0 2.0) (bold yes)) (justify left bottom)) (uuid "3622396b-fcc4-5c8f-8674-374082956b10"))
