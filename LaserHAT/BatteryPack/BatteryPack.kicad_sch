  (label "LED_DB" (at 580.39 477.52 0) (fields_autoplaced yes) (effects (font (size 1.27 1.27)) (justify left bottom)) (uuid "4c9b0dc4-9987-5f28-8698-da4f3c76847c"))
  (text "U19 runs the charge: at every slot end it pauses the charger (CHG_EN low), reads the connected pack at rest (R71 / R72), compares it with the other" (exclude_from_sim no) (at 535.94 474.98 0) (effects (font (size 1.27 1.27)) (justify left bottom)) (uuid "010397d2-2d2b-5e32-9df4-470a96e93d81"))
  (text "pack's last resting reading and keeps or swaps the relay (RELAY high = pack B), then restarts the charger.  DONE flags the pack as full; both full = idle." (exclude_from_sim no) (at 535.94 480.06 0) (effects (font (size 1.27 1.27)) (justify left bottom)) (uuid "2303ba7a-e2a0-549a-94f3-2fb0beafce52"))
  (text "D9 / D10 = pack A charging / done, D17 / D18 = pack B.  Program: hold SW2, plug into a PC, dfu-util (firmware/); or SWD on TP1 / TP2." (exclude_from_sim no) (at 535.94 485.14 0) (effects (font (size 1.27 1.27)) (justify left bottom)) (uuid "3d5350dc-6dea-5d5b-bf15-8df0e4e16407"))
