  (text "R1-R3: EN/CATH/RELEASE pulled low while the MCU pins are Hi-Z or the HAT 3V3 is off (zero current, electrode shorted)." (exclude_from_sim no) (at 22.86 119.38 0) (effects (font (size 1.27 1.27)) (justify left bottom)) (uuid "b55f9c33-7723-56ed-a201-8b5c49f6e5f9"))
  (text "R7/R8: I2C pull-ups, HAT side.  C1 at U1 pin 1, C2 between U1 pin 16 and U9 pin 5 (both VCC2), C17 at U9 pin 4." (exclude_from_sim no) (at 22.86 124.46 0) (effects (font (size 1.27 1.27)) (justify left bottom)) (uuid "be0ba0bf-ffea-5fc0-801f-282ce650a9f9"))
  (text "J8 (underside): 1 GND, 2 +5V, 3 FAULT_n (HAT PA6), 4 PWM_B=CATH, 5 PWM_A=EN.  J9: 1 GND, 2 +3V3, 3 RELEASE, 4 SDA, 5 SCL." (exclude_from_sim no) (at 22.86 33.02 0) (effects (font (size 1.27 1.27)) (justify left bottom)) (uuid "757dcf08-9d14-5552-82db-9767c278f5fc"))
