  (text "Decoupling at: C10 U4, C13/C14 U6.  MCP4921: set BUF = 1 (VREF input buffered), gain 1x." (exclude_from_sim no) (at 25.4 246.38 0) (effects (font (size 1.27 1.27)) (justify left bottom)) (uuid "a58b843f-357f-416f-93df-1a293ef6c645"))
  (text "VSET_P = 0..1 V.  4053: S1 = CATH picks -VSET / +VSET, S2 = EN picks that or 0 V -> V_IN.  EN low (isolator fail-safe) = zero current." (exclude_from_sim no) (at 25.4 256.54 0) (effects (font (size 1.27 1.27)) (justify left bottom)) (uuid "541bbc3b-f702-4455-9a55-87c2faba240b"))
