	(text "U15B below 12.0 V (back above 12.8 V: R53 from +OUT).  Chain A: Q11 (N, in pack A's negative) gets Vgs = pack A / 2 from R39 / R40 off EN_AI = CAB through Q26,"
		(exclude_from_sim no)
		(at 17.78 271.78 0)
		(effects
			(font
				(size 1.27 1.27)
			)
			(justify left bottom)
		)
		(uuid "1752642a-24d5-54e6-a531-ef35f756a340")
	)
	(text "Ladder (108 uA): TH80 2.162 V, TH50 2.054 V, TH20 1.946 V, THCUT 1.613 V.  VS = rail x 0.1357 with the output live, x 0.1271 cut off; the rail is the pack itself (P-FET)."
		(exclude_from_sim no)
		(at 261.62 220.98 0)
		(effects
			(font
				(size 1.27 1.27)
			)
			(justify left bottom)
		)
		(uuid "21febf1e-265f-5b44-8c0d-a3fe1847fb56")
	)
	(text "PACK B (+V side): 0V .. +BATB"
