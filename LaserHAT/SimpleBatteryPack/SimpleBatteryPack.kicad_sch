	)
	(text "H1-H4 corners, H9 / H10 between the packs, H11 / H12 mid-edge: M3, the case.  H5-H8 M2.5: a Raspberry Pi above."
		(exclude_from_sim no)
		(at 403.86 347.98 0)
		(effects
