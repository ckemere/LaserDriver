		(uuid "a54867dd-540f-5c75-9a92-efe2c7a0bd2b")
	)
	(text "SW1 ON: pole 1 puts EN_A at 0V (= pack A positive), pole 2 puts EN_B at +BATB; OFF opens both (R40 / R82 hold them low).  Chain B: Q22 (2N7002) conducts when ENB_G is high"
		(exclude_from_sim no)
		(at 17.78 261.62 0)
		(effects
