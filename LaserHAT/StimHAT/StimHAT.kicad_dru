(version 1)
(rule isolation_barrier
  (condition "((A.NetClass == 'Isolated' || A.NetClass == 'IsolatedPower' || A.NetClass == 'Rails') && !(B.NetClass == 'Isolated' || B.NetClass == 'IsolatedPower' || B.NetClass == 'Rails')) || ((B.NetClass == 'Isolated' || B.NetClass == 'IsolatedPower' || B.NetClass == 'Rails') && !(A.NetClass == 'Isolated' || A.NetClass == 'IsolatedPower' || A.NetClass == 'Rails'))")
  (constraint clearance (min 2.5mm)))
