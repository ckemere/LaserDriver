  (text "R101-R103 hold EN / CATH / RELEASE low while the MCU pins are Hi-Z (zero current, electrode shorted); R107 / R108" (exclude_from_sim no) (at 17.78 271.78 0) (effects (font (size 1.27 1.27)) (justify left bottom)) (uuid "381161de-ee6b-52b2-bba4-04d5536ce0c5"))
  (text "and R109 / R110 are the I2C pull-ups.  ISO1640: side 1 (pins 1-4) = MCU side, side 2 = DAC side.  C101 at U101.1, C103 at U109.1." (exclude_from_sim no) (at 17.78 276.86 0) (effects (font (size 1.27 1.27)) (justify left bottom)) (uuid "f1e442e5-f7e1-5654-89cf-2ab5c175c884"))
  (rectangle (start 157.48 162.56) (end 355.6 284.48) (stroke (width 0.2) (type dash)) (fill (type none)) (uuid "de33667e-6cdd-50ed-9b3e-e38a47edb32c"))
  (text "5. ISOLATED POWER: A0515S (PS1) OR THE BATTERY PACK (J102), LC + CAPACITANCE MULTIPLIERS, CLAMPS, +5 / -4.3 V" (exclude_from_sim no) (at 158.75 166.37 0) (effects (font (size 2.0 2.0) (bold yes)) (justify left bottom)) (uuid "0d456cc1-331c-591b-b2bc-ffa085485a37"))
