	(text "BNC IN: 5 V TTL tolerant (74LVC inputs), 100k pull-down, Schmitt trigger.\nBNC OUT: 3.3 V CMOS from U8 through 33R; STIM LED follows the output."
		(exclude_from_sim no)
		(at 30 30 0)
		(effects
			(font
				(size 1.27 1.27)
			)
			(justify left)
		)
		(uuid "9bdb8464-99f0-489b-8a35-a5b23de2b7cf")
	)
	(text "Daughterboard interface (two 1x5, 2.54 mm)\nJ8: 1 GND  2 +5V  3 PWM_A (PA21)  4 PWM_B (PA22, complement)  5 GPIO (PA26)\nJ9: 1 GND  2 +3V3 (switched MCU rail)  3 DAC (PA15)  4 ADC_A (PA17)  5 ADC_B (PA16)\nLaser board: ADC_A = photodiode monitor, ADC_B = compliance-rail divider."
		(exclude_from_sim no)
		(at 200 130 0)
		(effects
			(font
				(size 1.27 1.27)
			)
			(justify left)
		)
