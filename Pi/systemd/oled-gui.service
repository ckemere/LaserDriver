# LaserHAT OLED GUI — broker client that drives the panel through the
# compiled oledd daemon (laserhat-oledd.service).
#
# Connects to laserhat-broker.service over /run/laserhat/broker.sock and
# to laserhat-oledd over /run/laserhat-oled/oled.sock.  It opens neither
# the UART nor the I2C bus itself, so it runs alongside the web GUI.
#
# Installed by the laserhat package to /usr/lib/laserhat; stdlib-only
# Python, no pip packages.

[Unit]
Description=LaserHAT OLED GUI (broker client)
After=laserhat-broker.service laserhat-oledd.service
Wants=laserhat-oledd.service
Requires=laserhat-broker.service

[Service]
Type=simple
User=laserhat
Group=laserhat
WorkingDirectory=/usr/lib/laserhat
Environment=LASERHAT_SOCK=/run/laserhat/broker.sock
Environment=LASERHAT_OLED_SOCK=/run/laserhat-oled/oled.sock
ExecStart=/usr/bin/python3 oled_gui.py
Restart=on-failure
RestartSec=5
StandardOutput=journal
StandardError=journal

[Install]
WantedBy=multi-user.target
