# ============================================================
# Laser Driver - MSPM0G3507 / G1507 — arm-none-eabi-gcc build (Pi-native)
# ============================================================
# All required SDK files are vendored in-tree (see Makefile header).
# Only external dependency is the arm-none-eabi-gcc cross toolchain.
#
# Pi install:
#   sudo apt install gcc-arm-none-eabi
#   make -f Makefile.gcc                      # BOARD=rev2 (default)
#   make -f Makefile.gcc BOARD=stim           # StimHAT
#   make -f Makefile.gcc BOARD=laser          # LaserDriverHAT
#   make -f Makefile.gcc boards               # all three
#
# Outputs per board: build_gcc/<board>/main.{elf,bin,hex}

# Tools
CROSS           ?= arm-none-eabi
CC              := $(CROSS)-gcc
OBJCOPY         := $(CROSS)-objcopy
SIZE            := $(CROSS)-size

# Board (board.h): rev2 = LaserHAT Rev 2 (MSPM0G3507, plug-in modules),
# stim = StimHAT (MSPM0G1507, e-stim only), laser = LaserDriverHAT
# (MSPM0G1507, laser only).
BOARDS          := rev2 stim laser
BOARD           ?= rev2
ifeq ($(filter $(BOARD),$(BOARDS)),)
$(error BOARD must be one of: $(BOARDS) (got '$(BOARD)'))
endif
BOARD_DEF_rev2  := -DBOARD_REV2
BOARD_DEF_stim  := -DBOARD_STIM
BOARD_DEF_laser := -DBOARD_LASER
BOARD_DEF       := $(BOARD_DEF_$(BOARD))

# Paths
PROJ_DIR        := .
BUILD_ROOT      := $(PROJ_DIR)/build_gcc
BUILD_DIR       := $(BUILD_ROOT)/$(BOARD)

# Source files
STARTUP_SRC     := $(PROJ_DIR)/startup/startup_mspm0g350x_gcc.c
STARTUP_OBJ     := $(BUILD_DIR)/startup_mspm0g350x_gcc.o
LINKER_SCRIPT   := $(PROJ_DIR)/linker/mspm0g3507.lds

OBJS            := $(BUILD_DIR)/main.o \
                   $(BUILD_DIR)/output_mux.o \
                   $(BUILD_DIR)/sysctl.o \
                   $(BUILD_DIR)/gpio.o \
                   $(BUILD_DIR)/pwm_timer.o \
                   $(BUILD_DIR)/tick_timers.o \
                   $(BUILD_DIR)/dac.o \
                   $(BUILD_DIR)/adc.o \
                   $(BUILD_DIR)/module.o \
                   $(BUILD_DIR)/uart.o \
                   $(BUILD_DIR)/framing.o \
                   $(BUILD_DIR)/version.o \
                   $(STARTUP_OBJ)

# Version string reported over the wire (RSP_VERSION) — the same transform
# of `git describe` that pi/packaging/build-deb.sh uses for the Debian
# package version, so the broker can compare them.  Override with
# FW_VERSION=... (build-deb.sh passes the package version explicitly).
FW_VERSION      ?= $(shell git describe --tags --always --dirty 2>/dev/null \
                     | sed 's/^v//;s/-/+/g')
ifeq ($(strip $(FW_VERSION)),)
FW_VERSION      := unversioned
endif

# Compiler flags
CPU_FLAGS       := -mcpu=cortex-m0plus -mthumb
OPT_FLAGS       := -Os -g3
WARN_FLAGS      := -Wall -Wextra -Wno-unused-parameter
DEAD_CODE       := -ffunction-sections -fdata-sections
INCLUDES        := -I$(PROJ_DIR)
CFLAGS          := $(CPU_FLAGS) $(OPT_FLAGS) $(WARN_FLAGS) $(DEAD_CODE) \
                   $(INCLUDES) -std=c11 $(BOARD_DEF)

# Linker
LFLAGS          := $(CPU_FLAGS) -T$(LINKER_SCRIPT) \
                   -Wl,-Map=$(BUILD_DIR)/main.map \
                   -Wl,--gc-sections \
                   --specs=nano.specs --specs=nosys.specs \
                   -nostartfiles

# Output
TARGET_ELF      := $(BUILD_DIR)/main.elf
TARGET_BIN      := $(BUILD_DIR)/main.bin
TARGET_HEX      := $(BUILD_DIR)/main.hex

# OpenOCD (Pi-side SWD flashing)
OPENOCD            ?= openocd
OPENOCD_INTERFACE  ?= openocd/pi-swd.cfg
OPENOCD_TARGET     ?= target/ti_mspm0.cfg
# Override on Pi 5: make flash OPENOCD_GPIOCHIP=4
OPENOCD_GPIOCHIP   ?= 0
# Pi GPIOs for SWD, reset and MCU power enable differ between HATs:
#   BOARD=rev2:        SWCLK 24, SWDIO 25, NRST 23, POWER_EN 18, TRIGGER 26
#   BOARD=stim/laser:  SWCLK 24, SWDIO 25, NRST  9, POWER_EN 10, TRIGGER 18
#   Rev 1 HAT:         SWCLK 25, SWDIO 24, NRST 18, POWER_EN 23
#                      -> make flash HAT_REV=1 (the Rev 1 firmware itself is
#                      git tag `firmware-rev1`)
# Each can be overridden on the command line (OPENOCD_SRST=..., ...).
HAT_REV            ?= 2
ifeq ($(HAT_REV),1)
OPENOCD_SWCLK      ?= 25
OPENOCD_SWDIO      ?= 24
OPENOCD_SRST       ?= 18
PI_POWER_PIN       ?= 23
PI_TRIGGER_PIN     ?= 26
else ifeq ($(BOARD),rev2)
OPENOCD_SWCLK      ?= 24
OPENOCD_SWDIO      ?= 25
OPENOCD_SRST       ?= 23
PI_POWER_PIN       ?= 18
PI_TRIGGER_PIN     ?= 26
else
OPENOCD_SWCLK      ?= 24
OPENOCD_SWDIO      ?= 25
OPENOCD_SRST       ?= 9
PI_POWER_PIN       ?= 10
PI_TRIGGER_PIN     ?= 18
endif
OPENOCD_GPIO_ARGS  := \
    -c "adapter gpio swclk -chip $(OPENOCD_GPIOCHIP) $(OPENOCD_SWCLK)" \
    -c "adapter gpio swdio -chip $(OPENOCD_GPIOCHIP) $(OPENOCD_SWDIO)" \
    -c "adapter gpio srst  -chip $(OPENOCD_GPIOCHIP) $(OPENOCD_SRST)"

# ============================================================

.PHONY: all boards all-boards clean clean-all size flash load burn reset

all: $(TARGET_ELF) $(TARGET_BIN) $(TARGET_HEX) size

# Build every board (each into its own build_gcc/<board>/).
boards all-boards:
	@set -e; for b in $(BOARDS); do \
	    echo "=== BOARD=$$b ==="; \
	    $(MAKE) --no-print-directory -f Makefile.gcc BOARD=$$b all; \
	done

size: $(TARGET_ELF)
	@$(SIZE) $<

$(TARGET_ELF): $(OBJS) | $(BUILD_DIR)
	$(CC) $(OBJS) $(LFLAGS) -o $@

$(TARGET_BIN): $(TARGET_ELF)
	$(OBJCOPY) -O binary $< $@

$(TARGET_HEX): $(TARGET_ELF)
	$(OBJCOPY) -O ihex $< $@

$(BUILD_DIR)/%.o: $(PROJ_DIR)/%.c | $(BUILD_DIR)
	$(CC) $(CFLAGS) -c $< -o $@

# Every object depends on the headers (the board selection lives in them):
# a plain rebuild is cheap, so no generated dependency files.
HEADERS         := $(wildcard $(PROJ_DIR)/*.h)
# A stamp per board, so a BUILD_DIR override shared between boards (e.g.
# `make BOARD=stim BUILD_DIR=x` after BOARD=rev2) still rebuilds everything.
BOARD_STAMP     := $(BUILD_DIR)/.board_$(BOARD)
$(BOARD_STAMP): | $(BUILD_DIR)
	rm -f $(BUILD_DIR)/.board_*
	touch $@
$(OBJS): $(HEADERS) $(BOARD_STAMP)

# Always recompiled, so the string tracks the checkout (new commit, new tag,
# dirty tree) without a `make clean`.
$(BUILD_DIR)/version.o: $(PROJ_DIR)/version.c $(PROJ_DIR)/version.h FORCE | $(BUILD_DIR)
	$(CC) $(CFLAGS) -DFW_VERSION='"$(FW_VERSION)"' -c $< -o $@

FORCE:
.PHONY: FORCE

$(STARTUP_OBJ): $(STARTUP_SRC) | $(BUILD_DIR)
	$(CC) $(CFLAGS) -c $< -o $@

$(BUILD_DIR):
	mkdir -p $(BUILD_DIR)

clean:
	rm -rf $(BUILD_DIR)

clean-all:
	rm -rf $(BUILD_ROOT)

# Flash the freshly-built ELF to the MCU over SWD via OpenOCD.
# `load` and `burn` are aliases.
#
# Sequence: power_cycle.py brings the MCU up at fresh boot, the kernel
# UART driver is parked so it can't phantom-power the chip, and NRST is
# released.  OpenOCD then runs
# an explicit init / halt / flash write / reset sequence — rather
# than `program ... reset`, which triggers an automatic reset+halt
# inside init that we've observed timing out (the MCU is in the
# middle of the boot-blink busy-wait when the halt request arrives,
# and the subsequent reset's vector-catch isn't engaging).
#
# No verify step: the target-side CRC algorithm in ti_mspm0.cfg /
# OpenOCD 0.12.0+dev hangs the MCU, but the write itself is reliable.
# Visual confirmation of a successful flash is the ~4-second boot
# blink of the status LED D7 right after this rule finishes.
flash load burn: $(TARGET_ELF) power_cycle
	$(OPENOCD) -f $(OPENOCD_INTERFACE) $(OPENOCD_GPIO_ARGS) \
	    -f $(OPENOCD_TARGET) \
	    -c "init" \
	    -c "halt" \
	    -c "flash write_image erase $(TARGET_ELF)" \
	    -c "reset run" \
	    -c "shutdown"

# Pulse the MCU_POWER_EN GPIO LOW for 300 ms then HIGH.  Requires
# the Pi-side venv with gpiozero (see pi/README.md).
.PHONY: power_cycle
power_cycle:
	@export LASERHAT_BOARD=$(BOARD) LASERHAT_POWER_PIN=$(PI_POWER_PIN) \
	    LASERHAT_NRST_PIN=$(OPENOCD_SRST) LASERHAT_TRIGGER_PIN=$(PI_TRIGGER_PIN) \
	    LASERHAT_SWCLK_PIN=$(OPENOCD_SWCLK) LASERHAT_SWDIO_PIN=$(OPENOCD_SWDIO); \
	if [ -x $(HOME)/.venvs/laserhat/bin/python ]; then \
	    $(HOME)/.venvs/laserhat/bin/python ../pi/power_cycle.py ; \
	else \
	    python3 ../pi/power_cycle.py ; \
	fi

# Reset the MCU without changing what's in flash.
reset:
	$(OPENOCD) -f $(OPENOCD_INTERFACE) $(OPENOCD_GPIO_ARGS) \
	    -f $(OPENOCD_TARGET) \
	    -c "init; reset; exit"
