# ============================================================
# Laser Driver - MSPM0G3507 / G1507 — TI ARM CLANG build (workstation)
# ============================================================
# All required SDK files are vendored in-tree:
#   mcu.h                 -> hand-curated MSPM0G3507 device header
#   cmsis/                -> minimal CMSIS Cortex-M0+ core (7 files)
#   hw/                   -> peripheral register layout headers (7 files)
#   startup/              -> ticlang + gcc startup sources
#   linker/               -> ticlang + gcc memory layout
#
# Board: make -f Makefile.ticlang BOARD=rev2|stim|laser (default rev2),
# output build/<board>/main.out; `boards` builds all three.

# Tools — TI ARM CLANG.  Default install paths per OS; override on
# the command line (make CC=...) or via the CC environment variable
# if your install lives elsewhere.
#
#   Linux:  /opt/ti/ti-cgt-armllvm_<ver>.LTS/bin/tiarmclang
#   macOS:  ~/ti/ti-cgt-armllvm_<ver>.LTS/bin/tiarmclang
#
# Apple Silicon Macs: TI ships the toolchain x86_64-only, so Rosetta
# must be installed (softwareupdate --install-rosetta).
TI_TOOLCHAIN_VER ?= 5.1.0.LTS
UNAME_S          := $(shell uname -s)
# Only apply the OS default if the user hasn't overridden CC.  Make
# initialises CC=cc from its implicit rules, which makes `?=` no-op,
# so check $(origin CC) explicitly.
ifeq ($(origin CC),default)
  ifeq ($(UNAME_S),Linux)
    CC := /opt/ti/ti-cgt-armllvm_$(TI_TOOLCHAIN_VER)/bin/tiarmclang
  endif
  ifeq ($(UNAME_S),Darwin)
    CC := $(HOME)/ti/ti-cgt-armllvm_$(TI_TOOLCHAIN_VER)/bin/tiarmclang
  endif
endif

# Board (board.h); see Makefile.gcc.
BOARDS          := rev2 stim laser
BOARD           ?= rev2
ifeq ($(filter $(BOARD),$(BOARDS)),)
$(error BOARD must be one of: $(BOARDS) (got '$(BOARD)'))
endif
BOARD_DEF_rev2  := -DBOARD_REV2
BOARD_DEF_stim  := -DBOARD_STIM
BOARD_DEF_laser := -DBOARD_LASER
BOARD_DEF       := $(BOARD_DEF_$(BOARD))

# Paths
PROJ_DIR        := .
BUILD_ROOT      := $(PROJ_DIR)/build
BUILD_DIR       := $(BUILD_ROOT)/$(BOARD)

# Source files
STARTUP_SRC     := $(PROJ_DIR)/startup/startup_mspm0g350x_ticlang.c
STARTUP_OBJ     := $(BUILD_DIR)/startup_mspm0g350x_ticlang.o

OBJS            := $(BUILD_DIR)/main.o \
                   $(BUILD_DIR)/output_mux.o \
                   $(BUILD_DIR)/sysctl.o \
                   $(BUILD_DIR)/gpio.o \
                   $(BUILD_DIR)/pwm_timer.o \
                   $(BUILD_DIR)/tick_timers.o \
                   $(BUILD_DIR)/dac.o \
                   $(BUILD_DIR)/adc.o \
                   $(BUILD_DIR)/module.o \
                   $(BUILD_DIR)/uart.o \
                   $(BUILD_DIR)/framing.o \
                   $(BUILD_DIR)/version.o \
                   $(STARTUP_OBJ)

# Version string reported over the wire (RSP_VERSION); see Makefile.gcc.
FW_VERSION      ?= $(shell git describe --tags --always --dirty 2>/dev/null \
                     | sed 's/^v//;s/-/+/g')
ifeq ($(strip $(FW_VERSION)),)
FW_VERSION      := unversioned
endif

# Compiler flags
CPU_FLAGS       := -mcpu=cortex-m0plus -mthumb
OPT_FLAGS       := -O0 -g
INCLUDES        := -I$(PROJ_DIR)
CFLAGS          := $(CPU_FLAGS) $(OPT_FLAGS) $(INCLUDES) $(BOARD_DEF)

# Linker
LINKER_CMD      := $(PROJ_DIR)/linker/mspm0g3507.cmd
LFLAGS          := -Wl,--rom_model \
                   -Wl,-m,$(BUILD_DIR)/main.map \
                   -T$(LINKER_CMD)

# Output
TARGET          := $(BUILD_DIR)/main.out

# ============================================================

.PHONY: all boards all-boards clean clean-all

all: $(TARGET)
	@echo "Build complete: $(TARGET)"

boards all-boards:
	@set -e; for b in $(BOARDS); do \
	    echo "=== BOARD=$$b ==="; \
	    $(MAKE) --no-print-directory -f Makefile.ticlang BOARD=$$b all; \
	done

HEADERS         := $(wildcard $(PROJ_DIR)/*.h)
# A stamp per board, so a BUILD_DIR override shared between boards (e.g.
# `make BOARD=stim BUILD_DIR=x` after BOARD=rev2) still rebuilds everything.
BOARD_STAMP     := $(BUILD_DIR)/.board_$(BOARD)
$(BOARD_STAMP): | $(BUILD_DIR)
	rm -f $(BUILD_DIR)/.board_*
	touch $@
$(OBJS): $(HEADERS) $(BOARD_STAMP)

$(TARGET): $(OBJS) | $(BUILD_DIR)
	$(CC) $(CPU_FLAGS) $(OBJS) $(LFLAGS) -o $@

$(BUILD_DIR)/%.o: $(PROJ_DIR)/%.c | $(BUILD_DIR)
	$(CC) $(CFLAGS) -c $< -o $@

$(BUILD_DIR)/version.o: $(PROJ_DIR)/version.c $(PROJ_DIR)/version.h FORCE | $(BUILD_DIR)
	$(CC) $(CFLAGS) -DFW_VERSION='"$(FW_VERSION)"' -c $< -o $@

FORCE:
.PHONY: FORCE

$(STARTUP_OBJ): $(STARTUP_SRC) | $(BUILD_DIR)
	$(CC) $(CFLAGS) -c $< -o $@

$(BUILD_DIR):
	mkdir -p $(BUILD_DIR)

clean:
	rm -rf $(BUILD_DIR)

clean-all:
	rm -rf $(BUILD_ROOT)
