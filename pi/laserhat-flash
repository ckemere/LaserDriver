#!/bin/sh
#
# laserhat-flash — program the HAT's MCU (MSPM0) with the firmware shipped in
# the laserhat package, over SWD bit-banged from Pi GPIO.
#
#   sudo laserhat-flash                 flash the image for this board
#   sudo laserhat-flash -y              don't ask for confirmation
#   sudo laserhat-flash --board stim    board when the HAT EEPROM is blank
#   sudo laserhat-flash FILE.elf        flash a different image (reported,
#                                       not judged against the package)
#   --force                             flash although the HAT EEPROM names
#                                       a different board than --board (or
#                                       is another vendor's HAT)
#
# Which board: the HAT ID EEPROM (/proc/device-tree/hat, read by the Pi at
# boot) names it -- rev2 (LaserHAT Rev 2), stim (StimHAT) or laser
# (LaserDriverHAT).  The image is /usr/lib/laserhat/firmware/
# laserhat-mcu-<board>.elf and the GPIOs are that board's (Rev 2: NRST 23,
# POWER 18, TRIGGER 26; StimHAT / LaserDriverHAT: NRST 9, POWER 10,
# TRIGGER 18; SWCLK 24 / SWDIO 25 on all).  With a blank EEPROM: --board,
# else LASERHAT_BOARD (/etc/default/laserhat), else Rev 2.  LASERHAT_*_PIN
# variables override single pins.  `laserhat-eeprom read` shows the result.
#
# Sequence:
#   1. stop the broker (it holds the UART and the trigger line) and the GUIs
#   2. power-cycle the MCU (power_cycle.py, the board's POWER / NRST pins);
#      the firmware then sits in its ~2 s boot blink
#   3. OpenOCD over SWD (pi-swd.cfg + the board's SWCLK / SWDIO / NRST as
#      `adapter gpio` overrides): halt, erase + write, reset run
#   4. restart the broker + GUIs (every one that is enabled or was running)
#   5. verify: the broker asks the MCU for its version and board
#      (CMD_GET_VERSION) and this script prints whether they match the
#      package's VERSION file and the HAT (exit 3 if not, 4 if the MCU
#      never answered)
#
# Flash with no module in J8/J9 (Rev 2).  A blank MCU is inert.
#
# Success looks like the ~2 s boot blink of the status LED D7 after the
# write, then a short blip once a second, and "MCU firmware ... OK" here.

set -eu

FW_DIR=/usr/lib/laserhat/firmware
LIB_DIR=/usr/lib/laserhat
UNITS="laserhat-broker.service oled-gui.service laserhat-web.service"

die() { echo "laserhat-flash: $*" >&2; exit 1; }

ASSUME_YES=0
FORCE=0
BOARD=""
ELF=""
while [ $# -gt 0 ]; do
    case "$1" in
        -y|--yes)  ASSUME_YES=1 ;;
        --force)   FORCE=1 ;;
        --board)   [ $# -ge 2 ] || die "--board needs rev2, stim or laser"
                   BOARD=$2; shift ;;
        --board=*) BOARD=${1#--board=} ;;
        -h|--help) sed -n '2,41p' "$0" | sed 's/^# \{0,1\}//'; exit 0 ;;
        -*)        die "unknown option $1" ;;
        *)         ELF=$1 ;;
    esac
    shift
done
case "$BOARD" in
    ""|rev2|stim|laser) ;;
    *) die "--board must be rev2, stim or laser (got '$BOARD')" ;;
esac

[ "$(id -u)" -eq 0 ] || die "run with sudo (stops services, drives GPIO)"
command -v openocd >/dev/null || die "openocd not installed (sudo apt install openocd)"

# --- which board, which pins ------------------------------------------------
# /etc/default/laserhat may set LASERHAT_BOARD (boards without a programmed
# EEPROM) or LASERHAT_*_PIN; the broker unit reads the same file.
if [ -r /etc/default/laserhat ]; then
    set -a
    # shellcheck disable=SC1091
    . /etc/default/laserhat
    set +a
fi
RESOLVE_ARGS=""
[ -n "$BOARD" ] && RESOLVE_ARGS="--board $BOARD"
[ "$FORCE" -eq 1 ] && RESOLVE_ARGS="$RESOLVE_ARGS --force"
# shellcheck disable=SC2086
LH=$(python3 "$LIB_DIR/hat_id.py" shell $RESOLVE_ARGS) || die "hat_id.py failed"
eval "$LH"

[ -n "$LH_NOTES" ] && echo "note: $LH_NOTES"
if [ "$LH_FOREIGN_HAT" = 1 ] && [ "$FORCE" -ne 1 ]; then
    die "the HAT EEPROM names '$LH_EEPROM_VENDOR' '$LH_EEPROM_PRODUCT', not a LaserHAT-family board; refusing (--force to flash anyway as $LH_BOARD)"
fi
if [ "$LH_CONFLICT" = 1 ] && [ "$FORCE" -ne 1 ]; then
    die "the HAT EEPROM says this is a $LH_EEPROM_BOARD board, --board says $BOARD: refusing to flash $BOARD firmware (--force to override)"
fi

PACKAGED=0
if [ -z "$ELF" ]; then
    ELF=$FW_DIR/laserhat-mcu-$LH_BOARD.elf
    PACKAGED=1
fi
[ -f "$ELF" ] || die "firmware image $ELF not found"

echo "Board:    $LH_DESCRIBE"
if [ -z "$LH_EEPROM_BOARD" ]; then
    echo "          (no HAT EEPROM identity: program it once with"
    echo "           sudo laserhat-eeprom write $LH_BOARD --yes, then reboot;"
    echo "           until then the broker assumes ${LASERHAT_BOARD:-rev2})"
fi
echo "Firmware: $ELF"
EXPECTED=""
[ -f "$FW_DIR/VERSION" ] && EXPECTED=$(tr -d '[:space:]' < "$FW_DIR/VERSION")
[ -n "$EXPECTED" ] && [ "$PACKAGED" -eq 1 ] && echo "Version:  $EXPECTED"
if [ "$ASSUME_YES" -ne 1 ]; then
    printf 'Remove any module from J8/J9 before flashing.  Continue? [y/N] '
    read -r answer
    case "$answer" in
        y|Y|yes|YES) ;;
        *) echo "aborted"; exit 1 ;;
    esac
fi

# --- 1. stop the broker + GUIs; bring back every enabled one after --------
# "Enabled", not "active": with a blank MCU a GUI can be between restarts
# (activating), and it must still come back once the board is flashed.
RESTART=""
for u in $UNITS; do
    if systemctl is-enabled --quiet "$u" || systemctl is-active --quiet "$u"; then
        RESTART="$RESTART $u"
    fi
done
RESTORED=0
restore() {
    [ "$RESTORED" -eq 1 ] && return
    RESTORED=1
    if [ -n "$RESTART" ]; then
        echo "restarting:$RESTART"
        # shellcheck disable=SC2086
        systemctl restart $RESTART || true
    fi
}
trap restore EXIT
echo "stopping: $UNITS"
# shellcheck disable=SC2086
systemctl stop $UNITS

# --- 2. power-cycle into the SWD window -----------------------------------
# Same resolution as above (EEPROM / --board / env), so the same pins.
PC_ARGS="--board $LH_BOARD"
[ "$FORCE" -eq 1 ] && PC_ARGS="$PC_ARGS --force"
# shellcheck disable=SC2086
python3 "$LIB_DIR/power_cycle.py" $PC_ARGS

# --- 3. write ---------------------------------------------------------------
# pi-swd.cfg names the Rev 2 pins; the -c overrides that follow it set this
# board's (and the gpiochip of this Pi model).  No verify step: OpenOCD's
# target-side CRC hangs this MCU (see firmware/Makefile.gcc); the write
# itself is reliable.
openocd -f "$FW_DIR/pi-swd.cfg" \
    -c "adapter gpio swclk -chip $LH_GPIOCHIP $LH_SWCLK" \
    -c "adapter gpio swdio -chip $LH_GPIOCHIP $LH_SWDIO" \
    -c "adapter gpio srst  -chip $LH_GPIOCHIP $LH_NRST" \
    -f target/ti_mspm0.cfg \
    -c "init" \
    -c "halt" \
    -c "flash write_image erase $ELF" \
    -c "reset run" \
    -c "shutdown"

echo "flashed; watch for the ~2 s boot blink on the status LED D7"

# --- 4. bring the stack back, 5. verify through the broker -----------------
restore
case " $RESTART " in
    *" laserhat-broker.service "*) ;;
    *) echo "broker not enabled here; skipping the version check"; exit 0 ;;
esac
if [ "$PACKAGED" -ne 1 ]; then
    EXPECTED=""             # a developer image: report, don't judge the version
fi
# The broker probes the MCU once it is alive (boot blink ~2 s, then the
# first STATUS); wait for the answer and compare with the package + HAT.
python3 - "$EXPECTED" <<'PYEOF'
import sys, time
sys.path.insert(0, "/usr/lib/laserhat")
import hat_client

expected = sys.argv[1]
client = None
end = time.monotonic() + 12.0
while time.monotonic() < end and client is None:
    try:
        client = hat_client.HatClient("/run/laserhat/broker.sock")
    except OSError:
        time.sleep(0.25)
if client is None:
    print("laserhat-flash: broker socket did not come up; check "
          "`systemctl status laserhat-broker`")
    sys.exit(4)
st = None
while time.monotonic() < end:
    st = client.get_state()
    if st is not None and st.fw_ok is not None:
        break
    time.sleep(0.25)
client.close()
if st is None:
    print("laserhat-flash: MCU never came alive after the flash (no STATUS); "
          "no boot blink = the write did not land")
    sys.exit(4)
if st.fw_version is None:
    print("laserhat-flash: MCU alive but did not answer CMD_GET_VERSION: "
          "it runs firmware older than 0.2.0-rc6 (the write did not land?)")
    sys.exit(4)
if expected and st.fw_version != expected:
    print(f"laserhat-flash: MCU firmware {st.fw_version} != package {expected}")
    sys.exit(3)
import protocol
if not protocol.board_matches(st.board, st.fw_board or "unknown"):
    print(f"laserhat-flash: MCU firmware is built for {st.fw_board}, but the broker "
          f"sees a {st.board} HAT ({st.board_source}); wrong image, or the HAT "
          "EEPROM is not programmed (laserhat-eeprom read)")
    sys.exit(3)
if not st.fw_ok and expected:
    print(f"laserhat-flash: MCU firmware {st.fw_version} proto {st.fw_proto} "
          "not accepted by the broker (protocol mismatch?)")
    sys.exit(3)
print(f"MCU firmware {st.fw_version} (proto {st.fw_proto}, board {st.fw_board}"
      + (f", package {expected}" if expected else "")
      + f") on {st.board_label}: OK")
PYEOF
