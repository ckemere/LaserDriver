# LaserHAT web GUI (Flask) — long-running daemon.
#
# A broker client: it connects to laserhat-broker.service over the Unix
# socket, so it needs no UART access and runs at the same time as the
# OLED GUI.  Binds 0.0.0.0:8080 — reachable on both the static wired
# address (192.168.17.10) and whatever address wifi obtains.
#
# Installed by the laserhat package to /usr/lib/laserhat; Flask comes
# from apt (python3-flask) — no venv, no pip.

[Unit]
Description=LaserHAT web GUI (Flask)
After=network.target laserhat-broker.service
Requires=laserhat-broker.service

[Service]
Type=simple
User=laserhat
Group=laserhat
WorkingDirectory=/usr/lib/laserhat
Environment=PORT=8080
Environment=HOST=0.0.0.0
Environment=LASERHAT_SOCK=/run/laserhat/broker.sock
ExecStart=/usr/bin/python3 web_app.py
Restart=on-failure
RestartSec=5
StandardOutput=journal
StandardError=journal

[Install]
WantedBy=multi-user.target
